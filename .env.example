# Copy to fastlane/.env.deploy (shared) and fastlane/.env.<stage> (per stage overrides). Both gitignored.
# Key files below are looked up in fastlane/keys/ (gitignored).
# Any extra var here (e.g. SENTRY_DISABLE_AUTO_UPLOAD=true) also reaches the native build.

# --- iOS ---
IOS_BUNDLE_ID=com.acme.app
APPLE_TEAM_ID=
MATCH_GIT_URL=
MATCH_PASSWORD=
ASC_KEY_ID=
ASC_ISSUER_ID=
# AuthKey.p8 in keys/ by default; or paste the key into ASC_KEY_CONTENT
ASC_KEY_FILE=AuthKey.p8
# IOS_WORKSPACE=ios/App.xcworkspace   (auto-detected)
# IOS_SCHEME=App                      (defaults to workspace name)
# App extensions as Target:suffix, comma separated. Bundle id = <IOS_BUNDLE_ID>.<suffix>
# IOS_EXTENSIONS=ShareExtension:share-extension

# --- Android ---
ANDROID_PACKAGE=com.acme.app
ANDROID_KEYSTORE_FILE=release.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
PLAY_JSON_KEY_FILE=play-service-account.json
PLAY_TRACK=internal
# completed = rolled out to testers right away; draft = you roll it out in Play Console.
# A Play app that has never been published only accepts draft.
PLAY_RELEASE_STATUS=completed

# --- Misc ---
# KIT_APP_ENV_VAR=EXPO_PUBLIC_APP_ENV  (env var that receives the stage name)
